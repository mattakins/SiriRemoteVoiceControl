<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ConsentText</key>
	<dict>
		<key>default</key>
		<string>This profile enables system-wide Bluetooth debug logging, including private Bluetooth data, so Siri Remote Voice Control can capture microphone packets from a paired A1962 Siri Remote. Bluetooth logs may contain sensitive device and traffic metadata. Remove this profile when it is no longer needed.</string>
	</dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadIdentifier</key>
			<string>com.siriremotevoicecontrol.bluetooth.logging.system</string>
			<key>PayloadType</key>
			<string>com.apple.system.logging</string>
			<key>PayloadUUID</key>
			<string>F7C2F875-D739-472A-B5C0-FD183C69D1F1</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>Subsystems</key>
			<dict>
				<key>com.apple.bluetooth</key>
				<dict>
					<key>DEFAULT-OPTIONS</key>
					<dict>
						<key>Enable-Private-Data</key>
						<true/>
						<key>Level</key>
						<dict>
							<key>Enable</key>
							<string>Debug</string>
							<key>Persist</key>
							<string>Debug</string>
						</dict>
					</dict>
				</dict>
			</dict>
			<key>System</key>
			<dict>
				<key>Enable-Logging</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>BluetoothCustomerLogging</key>
			<dict>
				<key>PrivateDataLogging</key>
				<true/>
			</dict>
			<key>FWStreamLogging</key>
			<dict>
				<key>FWCoreDumpEnable</key>
				<true/>
				<key>FWStreamLoggingEnable</key>
				<true/>
			</dict>
			<key>HCI</key>
			<dict>
				<key>lmpRouting</key>
				<true/>
			</dict>
			<key>HCITraces</key>
			<dict>
				<key>StackDebugEnabled</key>
				<true/>
			</dict>
			<key>PayloadIdentifier</key>
			<string>com.siriremotevoicecontrol.bluetooth.logging.mobilebluetooth</string>
			<key>PayloadType</key>
			<string>com.apple.MobileBluetooth.debug</string>
			<key>PayloadUUID</key>
			<string>AA5B61CC-F28A-42CB-844E-439098861F08</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Enables Bluetooth debug, HCI trace, firmware stream, and private-data logging for A1962 microphone capture.</string>
	<key>PayloadDisplayName</key>
	<string>Bluetooth Logging (Siri Remote Voice Control)</string>
	<key>PayloadIdentifier</key>
	<string>com.siriremotevoicecontrol.bluetooth.logging</string>
	<key>PayloadOrganization</key>
	<string>Siri Remote Voice Control</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadScope</key>
	<string>system</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>80777F68-CD75-4424-9D18-0A98C5F8DAFF</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
